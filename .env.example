# 复制为 .env.local 使用，不要把真实密钥提交到仓库
# VITE_ 前缀的变量会打包进前端产物，禁止写入密钥、Token、内网地址

# 应用标题，会注入 index.html 的 <title>
VITE_APP_TITLE=Vue3 Admin Starter
# 当前环境，可选值 development / production
VITE_APP_ENV=development
# 接口基础地址，需包含版本前缀，例如 http://localhost:8080/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1
# 请求超时时间，单位毫秒
VITE_API_TIMEOUT=10000
# 是否启用 Mock 数据
VITE_USE_MOCK=false
